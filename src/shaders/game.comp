#version 430
// Gameplay: advances the state by a number of fixed time steps.

layout(local_size_x = 1) in;

// x: left flipper, y: right flipper, z: 1 pull the plunger, -1 nudge; w: number of steps
layout(location = 0) uniform vec4 iInput;

#include "tweaks.frag"
#include "state.glsl"
#include "world.glsl"

const float DT = 1. / 120.;
#define SUBSTEPS 8 // the ball moves less than half its radius per substep

bool multiball()
{
    return ballCount + pending > 1;
}

// Velocity of the collider surface at p.
vec2 surfaceVelocity(vec2 p, float m)
{
    if (m >= M_PLANET && m < M_BALL) {
        int i = int(m - M_PLANET);
        return (planetPos(i, time + 0.01) - planetPos(i, time - 0.01)) * 50.;
    }
    if (m >= M_FLIP && m < M_SUN) {
        int i = int(m - M_FLIP);
        vec2 r = p - flipPivot(i);
        return flipVel[i] * (i > 0 ? -1. : 1.) * vec2(-r.y, r.x);
    }
    return vec2(0);
}

// A big award: scored, and shown in the display for a moment.
void bigAward(int points)
{
    award = points * mult;
    score += award;
    awardTime = 2.;
}

void bumper(int b, int i, vec2 n, int points)
{
    if (flash[i] < 0.8) {
        vel[b] += n * _TV(bumperKick, 0.55);
        flash[i] = 1.;
        score += points * mult;
        bumperEvents++;
        shake = max(shake, 0.4);
        if (i == 0) {
            hitStop = _TV(sunHitStop, 0.05);
            // multiball: the sun is the jackpot when lit, and it grows
            if (multiball() && jackpotLit > 0) {
                jackpotLit = 0;
                bigAward(jackpot);
                jackpotFlash = 1.;
                hitStop = 0.2;
                shake = 1.;
                slingEvents++;
            }
        }
    }
}

// More balls (3 at most), launched one after the other from the shooter lane.
void addBalls(int n)
{
    pending = min(pending + n, 3 - ballCount);
}

// Star targets: when the four are lit, the planets align and multiball starts.
// During multiball, they light the jackpot (on the sun) again.
void target(vec2 p)
{
    int k = targetIndex(p);
    if ((targetsLit & 1 << k) != 0) {
        score += 50 * mult;
        return;
    }
    targetsLit |= 1 << k;
    score += 250 * mult;
    slingEvents++;
    if (targetsLit == 15) {
        targetsLit = 0;
        shake = 1.;
        flash = vec4(1);
        bumperEvents++;
        if (multiball()) {
            // the jackpot is lit again and grows, and once per multiball a
            // ball is added
            jackpotLit = 1;
            jackpot += 2500;
            bigAward(2500);
            if (ballAdded == 0)
                addBalls(1);
            ballAdded = 1;
            hitStop = 0.2;
            return;
        }
        // each multiball needs one more set of targets than the previous one
        if (++sets <= multiballs) {
            bigAward(2000);
            hitStop = 0.15;
            return;
        }
        sets = 0;
        multiballs++;
        bigAward(5000);
        addBalls(2);
        ballSave = max(ballSave, 12.);
        alignTime = 1e-3;
        if (jackpot == 0)
            jackpot = 5000;
        jackpotLit = 1;
        launchDelay = 1.5;
        hitStop = 0.4;
    }
}

void collide(int b)
{
    vec2 p = ball[b];
    vec2 h = field(p, vel[b].y < 0.);
    if (h.x >= BALL_R)
        return;
    float m = h.y;
    vec2 e = vec2(1e-4, 0);
    vec2 n = normalize(vec2(field(p + e, vel[b].y < 0.).x - field(p - e, vel[b].y < 0.).x,
                            field(p + e.yx, vel[b].y < 0.).x - field(p - e.yx, vel[b].y < 0.).x));
    vec2 vs = surfaceVelocity(p - n * h.x, m);
    ball[b] += n * (BALL_R - h.x);

    vec2 v = vel[b] - vs;
    float vn = dot(v, n);
    if (vn >= 0.)
        return;
    float bounce = m == M_RAIL || m == M_SLING || m == M_POST ? _TV(rubberBounce, 0.7)
                 : m == M_FLIP || m == M_FLIP + 1. ? _TV(flipperBounce, 0.45)
                 : _TV(wallBounce, 0.5);
    vel[b] = vs + v - (1. + bounce) * vn * n;

    if (m == M_SUN) bumper(b, 0, n, 100);
    if (m >= M_PLANET && m < M_BALL) bumper(b, int(m - M_PLANET) + 1, n, m > M_PLANET + 1.5 ? 500 : 50);
    if (m == M_TARGET && vn < -0.2) target(p);
    if (m == M_SLING) {
        int side = p.x > CX ? 1 : 0;
        if ((side > 0 ? -n.x : n.x) > 0.5 && slingFlash[side] < 0.5) {
            vel[b] += n * _TV(slingKick, 0.75);
            slingFlash[side] = 1.;
            score += 10 * mult;
            slingEvents++;
            shake = max(shake, 0.3);
        }
    }
}

// Balls bounce off each other (same mass).
void collideBalls()
{
    for (int i = 0; i < ballCount; i++)
        for (int j = i + 1; j < ballCount; j++) {
            vec2 d = ball[j] - ball[i];
            float l = length(d);
            if (l > 2. * BALL_R || l < 1e-6) continue;
            vec2 n = d / l;
            ball[i] -= n * (BALL_R - l * 0.5);
            ball[j] += n * (BALL_R - l * 0.5);
            float vn = dot(vel[j] - vel[i], n);
            if (vn < 0.) {
                vel[i] += n * vn * 0.95;
                vel[j] -= n * vn * 0.95;
            }
        }
}

bool inLane(vec2 p)
{
    return p.x > 0.226 && p.y < -0.3;
}

// A new ball in the shooter lane, with a ball save.
void serve()
{
    ball[0] = vec2(LANE_X, -0.5 + BALL_R);
    vel[0] = vec2(0);
    ballCount = 1;
    ballSave = _TV(ballSaveTime, 8.);
}

// Top lanes: rolling through the three of them raises the multiplier.
void lanes(vec2 p)
{
    int k = int(floor((p.x - CX + 0.09) / 0.06));
    if (p.y > 0.4 && p.y < 0.44 && k >= 0 && k < 3) {
        if ((lanesLit & 1 << k) == 0) {
            lanesLit |= 1 << k;
            score += 100 * mult;
            slingEvents++;
        }
    }
    if (lanesLit == 7) {
        lanesLit = 0;
        mult = min(mult + 1, 5);
        bigAward(1000);
        flash = vec4(1);
        bumperEvents++;
        shake = 1.;
        hitStop = 0.15;
    }
}

void update()
{
    drainFlash = max(drainFlash - DT * 2., 0.);
    jackpotFlash = max(jackpotFlash - DT * 2., 0.);
    awardTime = max(awardTime - DT, 0.);
    if (hitStop > 0.) {
        hitStop -= DT;
        return;
    }
    time += DT;
    if (alignTime > 0.)
        alignTime = alignTime > 4. ? 0. : alignTime + DT;
    // light trails: a ball's position every other step, or during multiball
    // each step and one ball after the other (w: the ball)
    if ((++steps & 1) == 0 || ballCount > 1) {
        for (int i = TRAIL - 1; i > 0; i--)
            trail[i] = trail[i - 1];
        int b = steps % max(ballCount, 1);
        trail[0] = vec4(ball[b], length(vel[b]), b);
    }
    flash = max(flash - DT * 4., 0.);
    slingFlash = max(slingFlash - DT * 4., 0.);
    shake = max(shake - DT * 3., 0.);

    if (balls <= 0) {
        ballCount = 0;
        pending = 0;
        gameOver -= DT;
        if (gameOver <= 0.) {
            score = 0;
            balls = 3;
            mult = 1;
            lanesLit = 0;
            targetsLit = 0;
            jackpot = 0;
            sets = 0;
            multiballs = 0;
            serve();
        }
    }

    // multiball: launch the waiting balls when the shooter lane is free
    launchDelay -= DT;
    bool laneFree = true;
    for (int b = 0; b < ballCount; b++)
        laneFree = laneFree && !inLane(ball[b]);
    if (pending > 0 && launchDelay <= 0. && laneFree) {
        ball[ballCount] = vec2(LANE_X, -0.45);
        vel[ballCount++] = vec2(0, _TV(autoLaunchSpeed, 2.8));
        pending--;
        launchDelay = 0.8;
        flipperEvents++;
    }

    vec2 up = iInput.xy;
    for (int i = 0; i < 2; i++)
        if (up[i] > prevInput[i]) {
            flipperEvents++;
            // lane change: the lit lanes move toward the flipper's side
            lanesLit = (i > 0 ? lanesLit << 1 | lanesLit >> 2 : lanesLit >> 1 | lanesLit << 2) & 7;
        }

    const float h = DT / float(SUBSTEPS);
    for (int s = 0; s < SUBSTEPS; s++) {
        for (int i = 0; i < 2; i++) {
            float speed = up[i] > 0. ? _TV(flipUpSpeed, 25.) : _TV(flipDownSpeed, 12.);
            float a = clamp((up[i] > 0. ? FLIP_UP : FLIP_REST) - flip[i], -speed * h, speed * h);
            flipVel[i] = a / h;
            flip[i] += a;
        }
        for (int b = 0; b < ballCount; b++) {
            vel[b].y -= _TV(gravity, 1.1) * h;
            ball[b] += vel[b] * h;
            collide(b);
        }
        collideBalls();
    }

    bool inPlayfield = false;
    float lowest = 1.;
    vec2 watch = ball[0];
    for (int b = 0; b < ballCount; b++) {
        lanes(ball[b]);
        inPlayfield = inPlayfield || ball[b].x < 0.22;
        vel[b] *= 1. - _TV(rollingDamping, 0.1) * DT;
        float speed = length(vel[b]);
        if (speed > 3.2)
            vel[b] *= 3.2 / speed;
        if (ball[b].y < lowest) {
            lowest = ball[b].y;
            watch = ball[b];
        }
    }
    if (inPlayfield)
        ballSave = max(ballSave - DT, 0.); // counts once a ball is in the playfield

    // plunger: pull, then release
    if (iInput.z > 0.)
        plunger = min(plunger + DT * 1.2, 1.);
    else if (plunger > 0.) {
        for (int b = 0; b < ballCount; b++)
            if (ball[b].x > 0.226 && ball[b].y < -0.45)
                vel[b].y = plunger * _TV(plungerSpeed, 2.6) + 0.4;
        plunger = 0.;
    }
    // nudge
    if (iInput.z < 0. && prevInput.z >= 0. && shake < 0.5) {
        for (int b = 0; b < ballCount; b++)
            vel[b] += vec2(0, 0.25);
        shake = 1.;
    }
    prevInput.xyz = iInput.xyz;

    // drains
    for (int b = ballCount - 1; b >= 0; b--)
        if (ball[b].y < -0.53) {
            drainEvents++;
            shake = 1.;
            ball[b] = ball[--ballCount];
            vel[b] = vel[ballCount];
            if (ballSave > 0. && multiball())
                addBalls(1); // saved during multiball: launched again
        }
    if (!multiball())
        ballAdded = 0;
    if (balls > 0 && ballCount + pending == 0) {
        drainFlash = 1.;
        if (ballSave > 0.) {
            serve();
            ballSave = 0.;
            flash = vec4(1);
        } else {
            mult = 1;
            jackpot = 0;
            if (--balls > 0)
                serve();
            else
                gameOver = 3.;
        }
    }

    vec2 target = vec2(CX + (watch.x - CX) * 0.15, clamp(watch.y, -0.5, 0.5) * 0.06 + _TV(camY, -0.1));
    cam += (target - cam) * DT * 3.;
}

void main()
{
    for (int i = 0; i < int(iInput.w); i++)
        update();
}
