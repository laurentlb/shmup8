#version 430
// Gameplay: advances the state by a number of fixed time steps.

layout(local_size_x = 1) in;

// [0] x: strafe, y: move, z: buttons (1 fire + 2 jump), w: number of steps
// [1] x: yaw, y: pitch (radians)
layout(location = 0) uniform vec4 iInput[2];

#include "tweaks.frag"
#include "state.glsl"
#include "world.glsl"

const float DT = 1. / 120.;

float rnd()
{
    rng = rng * 1664525u + 1013904223u;
    return float(rng >> 8) / 16777216.;
}

vec3 rndDir()
{
    return normalize(vec3(rnd(), rnd(), rnd()) - .5);
}

// Quake-style: accelerate toward wish, up to the speed cap along it.
void accelerate(vec3 wish, float cap, float accel)
{
    float add = cap - dot(vel, wish);
    if (add > 0.)
        vel += wish * min(add, accel * DT);
}

void addSpark(vec3 p, float power)
{
    int k = 0;
    for (int i = 1; i < MAX_SPARKS; i++)
        if (spark[i].w < spark[k].w) k = i;
    spark[k] = vec4(p, power);
}

void newRun()
{
    started = 1;
    pos = vec3(5, R_BODY + .01, 0);
    vel = vec3(0);
    yawBase = -iInput[1].x;
    light = 1.;
    lap = 1;
    checkpoint = 0;
    lapTime = 0.;
    dead = 0.;
    spawnTimer = 2.;
    for (int i = 0; i < MAX_ENEMIES; i++)
        enemy[i].w = 0.;
    for (int i = 0; i < MAX_ORBS; i++)
        orb[i].w = 0.;
}

void hitEnemy(int i, vec3 dir)
{
    enemy[i].w--;
    enemyInfo[i].y = 1.;
    enemyVel[i].xyz += dir * 3.;
    hitEvents++;
    hitMark = 1.;
    if (enemy[i].w <= 0.) {
        // it bursts and releases its light
        enemy[i].w = 0.;
        killEvents++;
        kills++;
        shake = max(shake, .4);
        addSpark(enemy[i].xyz, 4.);
        for (int k = 0, n = 0; k < MAX_ORBS && n < 3; k++)
            if (orb[k].w <= 0.) {
                orb[k] = vec4(enemy[i].xyz, 1);
                orbVel[k].xyz = rndDir() * 6. + vec3(0, 3, 0);
                n++;
            }
    }
}

void update()
{
    time += DT;
    if (started == 0)
        newRun();
    shake = max(shake - DT * 3., 0.);
    hurt = max(hurt - DT * 2., 0.);
    kick = max(kick - DT * 6., 0.);
    hitMark = max(hitMark - DT * 5., 0.);
    lapFlash = max(lapFlash - DT, 0.);
    for (int i = 0; i < MAX_SPARKS; i++)
        spark[i].w = max(spark[i].w - DT * 5., 0.);

    float fire = mod(iInput[0].z, 2.), jump = step(2., iInput[0].z);
    yaw = iInput[1].x + yawBase;
    pitch = iInput[1].y;
    vec3 fw = vec3(cos(yaw), 0, sin(yaw)), rt = vec3(-fw.z, 0, fw.x);
    vec3 look = vec3(fw.x * cos(pitch), sin(pitch), fw.z * cos(pitch));
    vec3 eye = pos + vec3(0, EYE, 0);

    if (dead > 0.) {
        dead += DT;
        vel = vec3(0);
        if (dead > 3.)
            newRun();
    } else {
        lapTime += DT;
        light -= DT * (_TV(drain, .012) + .004 * float(lap));
        if (light <= 0.) {
            light = 0.;
            dead = DT;
            hurtEvents++;
        }

        // running and jumping
        vec3 wish = fw * iInput[0].y + rt * iInput[0].x;
        float wl = length(wish);
        if (wl > 0.)
            wish /= wl;
        float speed = _TV(runSpeed, 10.);
        if (grounded > 0) {
            float s = length(vel.xz);
            if (s > 0.)
                vel.xz *= max(s - max(s, 3.) * _TV(friction, 6.) * DT, 0.) / s;
            accelerate(wish, speed * sign(wl), speed * _TV(accel, 10.));
            bob += s * DT;
            if (jump > 0.) {
                vel.y = _TV(jumpSpeed, 7.);
                jumpEvents++;
            }
        } else
            accelerate(wish, sign(wl), speed * _TV(airAccel, 1.));
        vel.y -= _TV(gravity, 20.) * DT;
        pos += vel * DT;
        grounded = 0;
        for (int k = 0; k < 3; k++) {
            float d = level(pos);
            if (d >= R_BODY)
                break;
            vec3 n = levelNormal(pos);
            pos += n * (R_BODY - d);
            vel -= n * min(dot(vel, n), 0.);
            if (n.y > .7)
                grounded = 1;
        }

        // shooting: the bolt leaves the gun toward what the crosshair points at
        cooldown -= DT;
        if (fire > 0. && cooldown <= 0.) {
            cooldown = _TV(fireDelay, .11);
            kick = 1.;
            shotEvents++;
            float t = 0.;
            for (int k = 0; k < 40 && t < 80.; k++) {
                float d = level(eye + look * t);
                if (d < .05)
                    break;
                t += d;
            }
            vec3 muzzle = eye + look * .5 + rt * .2 - cross(rt, look) * .15;
            for (int k = 0; k < MAX_BOLTS; k++)
                if (bolt[k].w <= 0.) {
                    bolt[k] = vec4(muzzle, 1.2);
                    boltVel[k].xyz = normalize(eye + look * max(t, 2.) - muzzle) * _TV(boltSpeed, 70.);
                    break;
                }
        }

        // laps: the quarters of the track must be reached in order
        float along = trackPos(pos);
        int q = int(along / trackLength() * 4.);
        if (q == (checkpoint + 1) % 4) {
            checkpoint = q;
            if (q == 0) {
                lap++;
                lapEvents++;
                bestLap = bestLap > 0. ? min(bestLap, lapTime) : lapTime;
                lapTime = 0.;
                light = min(light + .25, 1.);
                lapFlash = 1.;
            }
        }

        // more enemies appear ahead, more of them on each lap
        int alive = 0;
        for (int i = 0; i < MAX_ENEMIES; i++)
            alive += int(enemy[i].w > 0.);
        spawnTimer -= DT;
        if (alive < min(2 + 2 * lap, MAX_ENEMIES) && spawnTimer <= 0.) {
            spawnTimer = max(_TV(spawnDelay, 2.5) - .25 * float(lap), .7);
            vec3 s = trackPoint(along + 25. + rnd() * 15.) + vec3(rnd() * 4. - 2., 1.8 + rnd() * 1.5, rnd() * 4. - 2.);
            for (int i = 0; i < MAX_ENEMIES; i++)
                if (enemy[i].w <= 0.) {
                    enemy[i] = vec4(s, 2. + floor(float(lap) * .5));
                    enemyVel[i] = vec4(0);
                    enemyInfo[i] = vec4(0, 0, 1.5, 0);
                    break;
                }
        }
    }

    // bolts
    for (int k = 0; k < MAX_BOLTS; k++) {
        if (bolt[k].w <= 0.)
            continue;
        bolt[k].w -= DT;
        vec3 p = bolt[k].xyz, v = boltVel[k].xyz, dir = normalize(v);
        float len = length(v) * DT;
        for (int i = 0; i < MAX_ENEMIES; i++) {
            if (enemy[i].w <= 0.)
                continue;
            vec3 e = enemy[i].xyz - p;
            float h = clamp(dot(e, dir), 0., len);
            if (length(e - dir * h) < .7 * enemyInfo[i].x + .1) {
                hitEnemy(i, dir);
                addSpark(p + dir * h, 1.5);
                bolt[k].w = 0.;
                break;
            }
        }
        float t = 0.;
        for (int s = 0; s < 4 && t < len && bolt[k].w > 0.; s++) {
            float d = level(p + dir * t);
            if (d < .05) {
                addSpark(p + dir * (t - .1), 1.);
                bolt[k].w = 0.;
            }
            t += d;
        }
        bolt[k].xyz += v * DT;
    }

    // enemies: they float toward the player and charge when close
    for (int i = 0; i < MAX_ENEMIES; i++) {
        if (enemy[i].w <= 0.)
            continue;
        vec4 info = enemyInfo[i];
        info.x = min(info.x + DT, 1.);
        info.yzw = max(info.yzw - vec3(6, 1, 1) * DT, 0.);
        vec3 e = enemy[i].xyz, v = enemyVel[i].xyz;
        vec3 to = eye - vec3(0, .3, 0) - e;
        float dist = length(to);
        to /= dist;
        if (enemyVel[i].w > 0.)
            enemyVel[i].w -= DT;
        else {
            v += (to * (_TV(enemySpeed, 4.) + .5 * float(lap)) - v) * DT * 2.;
            v.y += sin(time * 2. + float(i)) * DT * 2.;
            if (dist < 9. && info.z <= 0. && dead == 0.) {
                v = to * (12. + float(lap));
                enemyVel[i].w = .6;
                info.z = 2.5;
            }
        }
        // spread out
        for (int j = 0; j < MAX_ENEMIES; j++) {
            vec3 d = e - enemy[j].xyz;
            float l = length(d);
            if (j != i && enemy[j].w > 0. && l < 2.5 && l > 0.)
                v += d / l * (2.5 - l) * DT * 8.;
        }
        // keep away from the walls
        float dl = level(e);
        if (dl < 1.) {
            vec3 n = levelNormal(e);
            v += n * (1. - dl) * DT * 30.;
            if (dl < .6) {
                e += n * (.6 - dl);
                v -= n * min(dot(v, n), 0.) * 1.5;
            }
        }
        e += v * DT * info.x;
        // a bite
        vec3 body = pos + vec3(0, .5, 0) - e;
        if (length(body) < 1.3 && dead == 0. && info.x >= 1. && info.w <= 0.) {
            light -= _TV(biteDamage, .12);
            hurt = 1.;
            shake = 1.;
            hurtEvents++;
            vel += normalize(body) * 8. + vec3(0, 3, 0);
            v = -normalize(body) * 8.;
            enemyVel[i].w = 0.;
            info.zw = vec2(2, 1.5);
        }
        enemy[i].xyz = e;
        enemyVel[i].xyz = v;
        enemyInfo[i] = info;
        // far away: gone (others appear ahead)
        if (dist > 70. || dead > 0.)
            enemy[i].w = 0.;
    }

    // released light flies to the player
    for (int k = 0; k < MAX_ORBS; k++) {
        if (orb[k].w <= 0.)
            continue;
        vec3 to = pos + vec3(0, .6, 0) - orb[k].xyz;
        float d = length(to);
        orbVel[k].xyz = orbVel[k].xyz * .985 + to / d * 40. * DT;
        orb[k].xyz += orbVel[k].xyz * DT;
        if (d < .8) {
            orb[k].w = 0.;
            light = min(light + _TV(orbLight, .04), 1.);
        }
    }
}

void addLight(vec3 p, vec3 c)
{
    if (lightCount < MAX_LIGHTS && c.r > 0.) {
        lightPos[lightCount].xyz = p;
        lightCol[lightCount++].rgb = c;
    }
}

// The point lights: the player's lantern and muzzle flash, bolts, sparks,
// released light, the enemies' eyes.
void makeLights()
{
    vec3 eye = pos + vec3(0, EYE, 0);
    vec3 f = vec3(cos(yaw) * cos(pitch), sin(pitch), sin(yaw) * cos(pitch));
    vec3 r = normalize(cross(f, vec3(0, 1, 0))), u = cross(r, f);
    lightCount = 0;
    addLight(eye + u * .4 - f * .3, GOLD * (light * _TV(lantern, 1.2) + .05));
    addLight(eye + r * .2 - u * .2 + f * .55, GOLD * kick * kick * 6.);
    for (int i = 0; i < MAX_BOLTS; i++)
        addLight(bolt[i].xyz, GOLD * 3. * step(1e-4, bolt[i].w));
    for (int i = 0; i < MAX_SPARKS; i++)
        addLight(spark[i].xyz, GOLD * spark[i].w * 2.);
    for (int i = 0; i < MAX_ORBS; i++)
        addLight(orb[i].xyz, GOLD * 1.5 * orb[i].w);
    for (int i = 0; i < MAX_ENEMIES; i++)
        addLight(enemy[i].xyz + normalize(eye - enemy[i].xyz) * .6, RED * .6 * enemyInfo[i].x * step(1e-4, enemy[i].w));
}

void main()
{
    for (int i = 0; i < int(iInput[0].w); i++)
        update();
    makeLights();
}
