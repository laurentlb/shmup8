#version 430
// Gameplay: advances the state by a number of fixed time steps.

layout(local_size_x = 1) in;

// x: left flipper, y: right flipper, z: 1 pull the plunger, -1 nudge; w: number of steps
layout(location = 0) uniform vec4 iInput;

#include "tweaks.frag"
#include "state.glsl"
#include "world.glsl"

const float DT = 1. / 120.;
#define SUBSTEPS 8 // the ball moves less than half its radius per substep

vec2 fieldNormal(vec2 p)
{
    vec2 e = vec2(1e-4, 0);
    return normalize(vec2(field(p + e).x - field(p - e).x, field(p + e.yx).x - field(p - e.yx).x));
}

// Velocity of the collider surface at p.
vec2 surfaceVelocity(vec2 p, float m)
{
    if (m >= M_PLANET) {
        int i = int(m - M_PLANET);
        return (planetPos(i, time + 0.01) - planetPos(i, time - 0.01)) * 50.;
    }
    if (m >= M_FLIP && m < M_SUN) {
        int i = int(m - M_FLIP);
        vec2 r = p - flipPivot(i);
        return flipVel[i] * (i > 0 ? -1. : 1.) * vec2(-r.y, r.x);
    }
    return vec2(0);
}

void bumper(int i, vec2 n, int points)
{
    if (flash[i] < 0.8) {
        if (i == 0)
            hitStop = _TV(sunHitStop, 0.05);
        vel += n * _TV(bumperKick, 0.55);
        flash[i] = 1.;
        score += points * mult;
        bumperEvents++;
        shake = max(shake, 0.4);
    }
}

void collide()
{
    vec2 h = field(ball);
    if (h.x >= BALL_R)
        return;
    float m = h.y;
    vec2 n = fieldNormal(ball);
    vec2 vs = surfaceVelocity(ball - n * h.x, m);
    ball += n * (BALL_R - h.x);

    vec2 v = vel - vs;
    float vn = dot(v, n);
    if (vn >= 0.)
        return;
    float e = m == M_RAIL || m == M_SLING || m == M_POST ? _TV(rubberBounce, 0.7)
            : m == M_FLIP || m == M_FLIP + 1. ? _TV(flipperBounce, 0.45)
            : _TV(wallBounce, 0.5);
    vel = vs + v - (1. + e) * vn * n;

    if (m == M_SUN) bumper(0, n, 100);
    if (m >= M_PLANET) bumper(int(m - M_PLANET) + 1, n, m > M_PLANET + 1.5 ? 500 : 50);
    if (m == M_SLING) {
        int side = ball.x > CX ? 1 : 0;
        if ((side > 0 ? -n.x : n.x) > 0.5 && slingFlash[side] < 0.5) {
            vel += n * _TV(slingKick, 0.75);
            slingFlash[side] = 1.;
            score += 10 * mult;
            slingEvents++;
            shake = max(shake, 0.3);
        }
    }
}

// A new ball in the shooter lane, with a ball save.
void serve()
{
    ball = vec2(LANE_X, -0.5 + BALL_R);
    vel = vec2(0);
    ballSave = _TV(ballSaveTime, 8.);
}

// Top lanes: rolling through the three of them raises the multiplier.
void lanes()
{
    int k = int(floor((ball.x - CX + 0.09) / 0.06));
    if (ball.y > 0.4 && ball.y < 0.44 && k >= 0 && k < 3 && (lanesLit & 1 << k) == 0) {
        lanesLit |= 1 << k;
        score += 100 * mult;
        slingEvents++;
    }
    if (lanesLit == 7) {
        lanesLit = 0;
        mult = min(mult + 1, 5);
        score += 1000 * mult;
        flash = vec4(1);
        bumperEvents++;
        shake = 1.;
        hitStop = 0.15;
    }
}

void update()
{
    drainFlash = max(drainFlash - DT * 2., 0.);
    if (hitStop > 0.) {
        hitStop -= DT;
        return;
    }
    time += DT;
    flash = max(flash - DT * 4., 0.);
    slingFlash = max(slingFlash - DT * 4., 0.);
    shake = max(shake - DT * 3., 0.);

    if (balls <= 0) {
        ball = vec2(0, -2);
        gameOver -= DT;
        if (gameOver <= 0.) {
            score = 0;
            balls = 3;
            mult = 1;
            lanesLit = 0;
            serve();
        }
    }

    vec2 up = iInput.xy;
    for (int i = 0; i < 2; i++)
        if (up[i] > prevInput[i]) {
            flipperEvents++;
            // lane change: the lit lanes move toward the flipper's side
            lanesLit = (i > 0 ? lanesLit << 1 | lanesLit >> 2 : lanesLit >> 1 | lanesLit << 2) & 7;
        }

    const float h = DT / float(SUBSTEPS);
    for (int s = 0; s < SUBSTEPS; s++) {
        for (int i = 0; i < 2; i++) {
            float speed = up[i] > 0. ? _TV(flipUpSpeed, 25.) : _TV(flipDownSpeed, 12.);
            float a = clamp((up[i] > 0. ? FLIP_UP : FLIP_REST) - flip[i], -speed * h, speed * h);
            flipVel[i] = a / h;
            flip[i] += a;
        }
        if (balls > 0) {
            vel.y -= _TV(gravity, 1.1) * h;
            ball += vel * h;
            collide();
        }
    }
    lanes();
    if (ball.x < 0.22)
        ballSave = max(ballSave - DT, 0.); // counts once the ball is in the playfield
    vel *= 1. - _TV(rollingDamping, 0.1) * DT;
    float speed = length(vel);
    if (speed > 3.2)
        vel *= 3.2 / speed;

    // plunger: pull, then release
    if (iInput.z > 0.)
        plunger = min(plunger + DT * 1.2, 1.);
    else if (plunger > 0.) {
        if (ball.x > 0.226 && ball.y < -0.45)
            vel.y = plunger * _TV(plungerSpeed, 2.6) + 0.4;
        plunger = 0.;
    }
    // nudge
    if (iInput.z < 0. && prevInput.z >= 0. && shake < 0.5) {
        vel += vec2(0, 0.25);
        shake = 1.;
    }
    prevInput.xyz = iInput.xyz;

    // drain
    if (balls > 0 && ball.y < -0.53) {
        drainEvents++;
        shake = 1.;
        drainFlash = 1.;
        if (ballSave > 0.) {
            serve();
            ballSave = 0.;
            flash = vec4(1);
        } else {
            mult = 1;
            if (--balls > 0)
                serve();
            else
                gameOver = 3.;
        }
    }

    vec2 target = vec2(CX + (ball.x - CX) * 0.15, clamp(ball.y, -0.5, 0.5) * 0.06 + _TV(camY, -0.1));
    cam += (target - cam) * DT * 3.;
}

void main()
{
    for (int i = 0; i < int(iInput.w); i++)
        update();
}
