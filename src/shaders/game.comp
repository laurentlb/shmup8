#version 430
// Gameplay: advances the state by a number of fixed time steps.

layout(local_size_x = 1) in;

layout(location = 0) uniform vec4 iInput; // xy: direction, z: fire, w: number of steps

#include "tweaks.frag"
#include "state.glsl"
#include "world.glsl"

const float DT = 1. / 120.;

void updateEnemies()
{
    // one more enemy every 7 seconds
    enemyCount = min(2 + int(ceil(max(gameTime, 0.) / 7.)), MAX_ENEMIES);
    for (int i = 0; i < enemyCount; i++) {
        float kind = enemies[i].z;
        vec2 target = vec2(sin(gameTime + float(i)) * 0.8,
                           float(i) * 0.1 + sin(gameTime + 1.5) * 0.5 - 0.1);
        if (kind > 0.5) target = player;
        if (kind > 1.5) target = vec2(sin(gameTime), player.y);
        if (kind > 2.5) target = vec2(player.x, sin(gameTime));

        // slow down when reaching the target
        enemies[i].xy = mix(enemies[i].xy, target, _TV(enemySpeed, 0.0202));

        if (length(enemies[i].xy - player) < PLAYER_RADIUS + 0.02) {
            enemies[i].xy = vec2(sin(float(i)), 10); // move out of the screen
            hurt = 1.;
            lives--;
            hitEvents++;
        }
    }
}

void updateShots()
{
    for (int i = shotCount - 1; i >= 0; i--) {
        shots[i].y += DT;
        for (int j = 0; j < enemyCount; j++) {
            vec2 p = shots[i].xy;
            // The second distance fills the hole of the hollow enemies.
            if (p.y < 1. && min(enemyDist(p, j), length(p - enemies[j].xy) - 0.03) < SHOT_RADIUS) {
                score++;
                boomEvents++;
                if (boomCount < MAX_BOOMS)
                    booms[boomCount++] = vec4(p, 1, 0);
                enemies[j].y = -10.;
                shots[i].y = 10.;
            }
        }
        if (shots[i].y > 0.6)
            shots[i] = shots[--shotCount];
    }

    if (iInput.z > 0. && gameTime - coolDown > _TV(fireDelay, 0.15) && shotCount < MAX_SHOTS) {
        coolDown = gameTime;
        shots[shotCount++] = vec4(player, 0, 0);
        shotEvents++;
    }
}

void update()
{
    gameTime += DT;
    hurt = max(hurt - DT, 0.);
    player = clamp(player + iInput.xy * DT * _TV(playerSpeed, 0.8), vec2(-1, -.5), vec2(1, .5));

    for (int i = boomCount - 1; i >= 0; i--) {
        booms[i].z -= DT;
        if (booms[i].z <= 0.)
            booms[i] = booms[--boomCount];
    }

    // new game
    if (gameTime >= 0. && gameTime < 1.) {
        if (gameTime < 0.5)
            player = mix(player, vec2(0, -0.3), 0.1056);
        score = 0;
        hurt = 0.;
        lives = 3;
        for (int i = 0; i < MAX_ENEMIES; i++)
            enemies[i] = vec4(0, 10, i == 3 || i == 4 ? 1. : i == 5 ? 2. : i == 6 ? 3. : 0., 0);
    }

    updateEnemies();
    updateShots();

    // death
    if (gameTime > 2. && lives <= 0) {
        gameTime = -2.;
        coolDown = gameTime;
    }
}

void main()
{
    for (int i = 0; i < int(iInput.w); i++)
        update();
}
