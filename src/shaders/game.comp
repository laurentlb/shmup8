#version 430
// Gameplay: advances the state by a number of fixed time steps.

layout(local_size_x = 1) in;

// [0] x: strafe, y: move, z: buttons (1 fire + 2 jump + 4 rocket), w: number of steps
// [1] x: yaw, y: pitch (radians)
layout(location = 0) uniform vec4 iInput[2];

#include "tweaks.frag"
#include "state.glsl"
#include "world.glsl"

const float DT = 1. / 120.;

float rnd()
{
    rng = rng * 1664525u + 1013904223u;
    return float(rng >> 8) / 16777216.;
}

vec3 rndDir()
{
    return normalize(vec3(rnd(), rnd(), rnd()) - .5);
}

// Quake-style: accelerate toward wish, up to the speed cap along it.
void accelerate(vec3 wish, float cap, float accel)
{
    float add = cap - dot(vel, wish);
    if (add > 0.)
        vel += wish * min(add, accel * DT);
}

void addSpark(vec3 p, float power)
{
    int k = 0;
    for (int i = 1; i < MAX_SPARKS; i++)
        if (spark[i].w < spark[k].w) k = i;
    spark[k] = vec4(p, power);
}

void newRun()
{
    started = 1;
    pos = vec3(5, R_BODY + .01, 0);
    vel = vec3(0);
    yawBase = -iInput[1].x;
    light = 1.;
    lap = 1;
    kills = 0;
    rockets = 5;
    taken = 0;
    checkpoint = 0;
    lapTime = 0.;
    dead = 0.;
    spawnTimer = 1.;
    for (int i = 0; i < MAX_ENEMIES; i++)
        enemy[i].w = 0.;
    for (int i = 0; i < MAX_ORBS; i++)
        orb[i].w = 0.;
    for (int i = 0; i < MAX_SHOTS; i++)
        shot[i].w = 0.;
    for (int i = 0; i < MAX_ROCKETS; i++)
        rocket[i].w = 0.;
}

void hurtPlayer(float damage)
{
    light -= damage;
    hurt = 1.;
    shake = 1.;
    hurtEvents++;
}

void hitEnemy(int i, vec3 dir, float damage)
{
    enemy[i].w -= damage;
    enemyInfo[i].y = 1.;
    enemyVel[i].xyz += dir * 3. / enemyScale(enemyKind[i]);
    hitEvents++;
    hitMark = 1.;
    if (enemy[i].w <= 0.) {
        // it bursts and releases its light (more for a brute)
        enemy[i].w = -.3;
        killEvents++;
        kills++;
        shake = max(shake, .4);
        addSpark(enemy[i].xyz, 4.);
        if (enemyKind[i] == 4) {
            // the warden: rockets, and a flash
            rockets = min(rockets + 4, 15);
            pickupEvents++;
            lapFlash = shake = 1.;
        }
        for (int k = 0, n = 0; k < MAX_ORBS && n < (enemyKind[i] > 2 ? 12 : enemyKind[i] == 2 ? 2 : 3); k++)
            if (orb[k].w <= 0.) {
                orb[k] = vec4(enemy[i].xyz, 1);
                orbVel[k].xyz = rndDir() * 6. + vec3(0, 3, 0);
                n++;
            }
    }
}

// A rocket explodes: damage and knockback around, the player is pushed
// (rocket jumps) but not hurt.
void explode(vec3 c)
{
    boomEvents++;
    shake = 1.;
    addSpark(c, 6.);
    for (int k = 0; k < MAX_ROCKETS; k++)
        if (blast[k].w <= 0.) {
            blast[k] = vec4(c, DT);
            break;
        }
    for (int i = 0; i < MAX_ENEMIES; i++) {
        vec3 d = enemy[i].xyz - c;
        float k = 1. - length(d) / _TV(blastRadius, 5.);
        if (enemy[i].w > 0. && k > 0.) {
            enemyVel[i].xyz += normalize(d) * 10. * k;
            hitEnemy(i, vec3(0), ceil(_TV(blastDamage, 7.) * k));
        }
    }
    vec3 d = pos - c;
    float k = 1. - length(d) / 4.;
    if (k > 0.) {
        vel += normalize(d + vec3(0, .3, 0)) * _TV(rocketJump, 16.) * k;
        grounded = 0;
    }
}

// The direction from the muzzle to what the crosshair points at.
vec3 aim(vec3 eye, vec3 look, vec3 muzzle)
{
    float t = 0.;
    for (int k = 0; k < 40 && t < 80.; k++) {
        float d = level(eye + look * t);
        if (d < .05)
            break;
        t += d;
    }
    return normalize(eye + look * max(t, 2.) - muzzle);
}

void spawn(vec3 s, int kind)
{
    for (int i = 0; i < MAX_ENEMIES; i++)
        if (enemy[i].w == 0.) {
            enemy[i] = vec4(s, float(ENEMY_HEALTH[kind] + lap / 2 * healthUp(kind)));
            enemyKind[i] = kind;
            enemyVel[i] = vec4(0);
            enemyInfo[i] = vec4(0, 0, 1.5, 0);
            enemyGoal[i] = vec4(s, 0);
            return;
        }
}

void update()
{
    time += DT;
    tick++;
    if (started == 0) {
        // the title: the camera glides along the route, until a key or a click
        vec3 a = vec3(0), b = vec3(0);
        for (int k = 0; k < 4; k++)
            a += trackPoint(time * 2.5 + float(k)), b += trackPoint(time * 2.5 + 7. + float(k));
        pos = a / 4. + vec3(0, R_BODY + .5, 0);
        b -= a;
        yaw = atan(b.z, b.x);
        pitch = -.06 + .04 * sin(time * .4);
        light = 1.;
        if (iInput[0].z + abs(iInput[0].x) + abs(iInput[0].y) > 0.)
            newRun();
        return;
    }
    shake = max(shake - DT * 3., 0.);
    hurt = max(hurt - DT * 2., 0.);
    kick = max(kick - DT * 6., 0.);
    hitMark = max(hitMark - DT * 5., 0.);
    lapFlash = max(lapFlash - DT, 0.);
    pickupFlash = max(pickupFlash - DT * 3., 0.);
    for (int i = 0; i < MAX_SPARKS; i++)
        spark[i].w = max(spark[i].w - DT * 5., 0.);
    for (int i = 0; i < MAX_ROCKETS; i++)
        blast[i].w = blast[i].w > .6 ? 0. : blast[i].w + sign(blast[i].w) * DT;

    float buttons = iInput[0].z, fire = mod(buttons, 2.), jump = mod(floor(buttons * .5), 2.);
    yaw = iInput[1].x + yawBase;
    pitch = iInput[1].y;
    vec3 fw = vec3(cos(yaw), 0, sin(yaw)), rt = vec3(-fw.z, 0, fw.x);
    vec3 look = vec3(fw.x * cos(pitch), sin(pitch), fw.z * cos(pitch));
    vec3 eye = pos + vec3(0, EYE, 0), up = cross(rt, look);

    if (dead > 0.) {
        // the results; fire for a new run (or wait)
        dead += DT;
        vel = vec3(0);
        if (dead > 2. && fire > prevButtons || dead > 10.)
            newRun();
    } else {
        lapTime += DT;
        light -= DT * (_TV(drain, .01) + .006 * float(lap));
        if (light <= 0.) {
            light = 0.;
            dead = DT;
            hurtEvents++;
            record = max(record, lap - 1);
        }
        // low light: a heartbeat, faster as the light runs out
        if (light < .3 && time - beatAt > .3 + light * 2.)
            beatAt = time, beatEvents++;

        // running and jumping
        vec3 wish = fw * iInput[0].y + rt * iInput[0].x;
        float wl = length(wish);
        if (wl > 0.)
            wish /= wl;
        float speed = _TV(runSpeed, 10.);
        if (grounded > 0) {
            float s = length(vel.xz);
            if (s > 0.)
                vel.xz *= max(s - max(s, 3.) * _TV(friction, 6.) * DT, 0.) / s;
            accelerate(wish, speed * sign(wl), speed * _TV(accel, 10.));
            bob += s * DT;
            if (jump > 0.) {
                vel.y = _TV(jumpSpeed, 7.);
                jumpEvents++;
            }
        } else
            accelerate(wish, sign(wl), speed * _TV(airAccel, 1.));
        vel.y -= _TV(gravity, 20.) * DT;
        pos += vel * DT;
        grounded = 0;
        for (int k = 0; k < 3; k++) {
            float d = level(pos);
            if (d >= R_BODY)
                break;
            vec3 n = levelNormal(pos);
            pos += n * (R_BODY - d);
            vel -= n * min(dot(vel, n), 0.);
            if (n.y > .7)
                grounded = 1;
        }

        // the light gun: the bolts leave the gun toward what the crosshair
        // points at. It gets better on each lap: faster, then two and three bolts.
        cooldown -= DT;
        if (fire > 0. && cooldown <= 0.) {
            int power = min(lap - 1, 3);
            cooldown = _TV(fireDelay, .11) - .01 * float(power);
            kick = 1.;
            shotEvents++;
            vec3 muzzle = eye + look * .5 + rt * .2 - up * .15;
            vec3 dir = aim(eye, look, muzzle);
            for (int j = 0, k = 0; j < max(power, 1) && k < MAX_BOLTS; k++)
                if (bolt[k].w <= 0.) {
                    bolt[k] = vec4(muzzle, .8);
                    boltVel[k].xyz = normalize(dir + rt * (float(j++) - float(max(power, 1) - 1) * .5) * .035) * _TV(boltSpeed, 70.);
                }
        }
        // the rocket launcher: limited rockets
        rocketDelay -= DT;
        if (buttons >= 4. && rocketDelay <= 0. && rockets > 0) {
            rocketDelay = .7;
            rockets--;
            launchEvents++;
            kick = 2.;
            vec3 muzzle = eye + look * .5 + rt * .2 - up * .21;
            for (int k = 0; k < MAX_ROCKETS; k++)
                if (rocket[k].w <= 0.) {
                    rocket[k] = vec4(muzzle, 3);
                    rocketVel[k].xyz = aim(eye, look, muzzle) * _TV(rocketSpeed, 30.);
                    break;
                }
        }

        // ammo crates: rockets
        for (int k = 0; k < NP; k++)
            if ((taken >> k & 1) == 0 && length(pos - PICKUPS[k]) < 1.5) {
                taken |= 1 << k;
                rockets = min(rockets + 3, 15);
                pickupEvents++;
                pickupFlash = 1.;
            }

        // laps: the quarters of the track must be reached in order
        float along = trackPos(pos);
        int q = int(along / trackLength() * 4.);
        if (q == (checkpoint + 1) % 4) {
            checkpoint = q;
            if (q == 0) {
                lap++;
                lapEvents++;
                bestLap = bestLap > 0. ? min(bestLap, lapTime) : lapTime;
                lapTime = 0.;
                light = min(light + _TV(lapLight, .1), 1.);
                lapFlash = 1.;
                taken = 0; // the crates are back
            }
            // from lap 2, half-way: the warden comes, ahead (one at a time)
            bool warden = q == 2 && lap > 1;
            for (int i = 0; i < MAX_ENEMIES; i++)
                warden = warden && (enemyKind[i] != 4 || enemy[i].w <= 0.);
            if (warden)
                spawn(trackPoint(along + 25.) + vec3(0, 3, 0), 4);
        }

        // more enemies appear on the route (mostly ahead, sometimes behind),
        // more of them, and more kinds, on each lap
        int alive = 0, brutes = 0;
        for (int i = 0; i < MAX_ENEMIES; i++) {
            alive += int(enemy[i].w > 0.);
            brutes += int(enemy[i].w > 0. && enemyKind[i] == 3);
        }
        spawnTimer -= DT;
        if (alive < min(3 + 2 * lap, MAX_ENEMIES - 2) && spawnTimer <= 0.) {
            spawnTimer = max(_TV(spawnDelay, 2.5) - .25 * float(lap), .7);
            vec3 s = trackPoint(along + (rnd() < .25 ? -10. - rnd() * 8. : 18. + rnd() * 15.));
            float r = rnd();
            if (lap > 2 && brutes == 0 && r < .15)
                spawn(s + vec3(0, 3, 0), 3);
            else if (r < .35)
                // skitters come in packs, on the floor
                for (int k = 0; k < 3; k++)
                    spawn(s + vec3(rnd() * 3. - 1.5, .5, rnd() * 3. - 1.5), 2);
            else
                spawn(s + vec3(rnd() * 4. - 2., 1.8 + rnd() * 1.5, rnd() * 4. - 2.), int(rnd() < min(.15 + .1 * float(lap), .5)));
        }
    }

    // bolts
    for (int k = 0; k < MAX_BOLTS; k++) {
        if (bolt[k].w <= 0.)
            continue;
        bolt[k].w -= DT;
        vec3 p = bolt[k].xyz, v = boltVel[k].xyz, dir = normalize(v);
        float len = length(v) * DT;
        for (int i = 0; i < MAX_ENEMIES; i++) {
            if (enemy[i].w <= 0.)
                continue;
            vec3 e = enemy[i].xyz - p;
            float h = clamp(dot(e, dir), 0., len);
            if (length(e - dir * h) < .9 * enemyScale(enemyKind[i]) * enemyInfo[i].x + .1) {
                hitEnemy(i, dir, 1.);
                addSpark(p + dir * h, 1.5);
                bolt[k].w = 0.;
                break;
            }
        }
        float t = 0.;
        for (int s = 0; s < 4 && t < len && bolt[k].w > 0.; s++) {
            float d = level(p + dir * t);
            if (d < .05) {
                addSpark(p + dir * (t - .1), 1.);
                bolt[k].w = 0.;
            }
            t += d;
        }
        bolt[k].xyz += v * DT;
    }

    // rockets: they explode on the walls and on the enemies
    for (int k = 0; k < MAX_ROCKETS; k++) {
        if (rocket[k].w <= 0.)
            continue;
        rocket[k].w -= DT;
        rocket[k].xyz += rocketVel[k].xyz * DT;
        bool boom = rocket[k].w <= 0. || level(rocket[k].xyz) < .25;
        for (int i = 0; i < MAX_ENEMIES; i++)
            boom = boom || enemy[i].w > 0. && length(enemy[i].xyz - rocket[k].xyz) < enemyScale(enemyKind[i]) + .3;
        if (boom) {
            rocket[k].w = 0.;
            explode(rocket[k].xyz);
        }
    }

    // enemies. Each one checks now and then whether it sees the player:
    // then it attacks; otherwise it follows the route toward the player.
    float playerAlong = trackPos(pos), len = trackLength();
    for (int i = 0; i < MAX_ENEMIES; i++) {
        if (enemy[i].w < 0.)
            enemy[i].w = min(enemy[i].w + DT, 0.); // bursting
        if (enemy[i].w <= 0.)
            continue;
        int kind = enemyKind[i];
        float size = enemyScale(kind);
        vec4 info = enemyInfo[i];
        info.x = min(info.x + DT, 1.);
        info.yzw = max(info.yzw - vec3(6, 1, 1) * DT, 0.);
        vec3 e = enemy[i].xyz, v = enemyVel[i].xyz;
        vec3 to = eye - vec3(0, .3, 0) - e;
        float dist = length(to);
        to /= dist;
        if ((tick + i * 7) % 24 == 0) {
            float t = size + .3;
            for (int k = 0; k < 32 && t < dist; k++)
                t += max(level(e + to * t), .2);
            vec3 goal = eye - vec3(0, .3, 0);
            if (t < dist) {
                float along = trackPos(e);
                goal = trackPoint(along + sign(mod(playerAlong - along + len * .5, len) - len * .5) * 5.)
                     + vec3(0, kind == 2 ? .5 : 2., 0);
            }
            enemyGoal[i] = vec4(goal, t >= dist);
        }
        bool see = enemyGoal[i].w > 0.;
        vec3 go = enemyGoal[i].xyz - e;
        go /= max(length(go), .01);
        vec3 side = normalize(cross(to, vec3(0, 1, 0))) * sin(time * 2.5 + float(i) * 2.) * float(see);
        float speed = _TV(enemySpeed, 4.5) + .5 * float(lap);
        if (kind == 2) {
            // skitter: runs on the floor, leaps at the player
            vec3 ahead = vec3(go.x, 0, go.z) / max(length(go.xz), .01);
            v.y -= 20. * DT;
            if (level(e - vec3(0, .1, 0)) < size) {
                v.xz += ((ahead.xz + side.xz * .6) * (7. + float(lap)) - v.xz) * DT * 6.;
                if (see && dist < 7. && info.z <= 0. && dead == 0.) {
                    v = ahead * 12. + vec3(0, 6, 0);
                    info.z = 1.5;
                }
            }
        } else if (kind == 0) {
            // wraith: weaves toward the player, charges when close
            if (enemyVel[i].w > 0.)
                enemyVel[i].w -= DT;
            else {
                v += (go * speed + side * 4. - v) * DT * 2.;
                if (see && dist < 10. && info.z <= 0. && dead == 0.) {
                    v = to * (13. + float(lap));
                    enemyVel[i].w = .6;
                    info.z = 2.5;
                }
            }
        } else {
            // spitter (1), brute (3) and warden (4): keep away, circle,
            // shoot when they see the player (a fan of 3 or 5 shots)
            float range = kind == 1 ? 14. : 10.;
            int fan = max(kind - 2, 0);
            v += ((see ? to * clamp(dist - range, -1., 1.) : go) * speed * (kind == 3 ? .5 : 1.) + side * 4. - v) * DT * 1.5;
            if (info.z <= 0. && dist < 30. && dead == 0.) {
                info.z = .4;
                if (see) {
                    vec3 r = normalize(cross(to, vec3(0, 1, 0)));
                    for (int j = -fan, k = 0; j <= fan && k < MAX_SHOTS; k++)
                        if (shot[k].w <= 0.) {
                            shot[k] = vec4(e + to * size, 3);
                            shotVel[k].xyz = normalize(to + r * float(j++) * (.1 + .05 * float(fan))) * (12. + float(lap));
                            spitEvents++;
                            info.z = max(2.2 - .2 * float(lap), 1.) * (kind == 1 ? 1. : 1.5);
                        }
                }
            }
        }
        if (kind != 2)
            v.y += sin(time * 2. + float(i)) * DT * 2.;
        // spread out
        for (int j = 0; j < MAX_ENEMIES; j++) {
            vec3 d = e - enemy[j].xyz;
            float l = length(d), r = (size + enemyScale(enemyKind[j])) * 1.5;
            if (j != i && enemy[j].w > 0. && l < r && l > 0.)
                v += d / l * (r - l) * DT * 8.;
        }
        // the walls: the floaters keep away from them, the skitters stand on the floor
        float dl = level(e), keep = kind == 2 ? size : size * .9;
        if (dl < keep + .4) {
            vec3 n = levelNormal(e);
            if (kind != 2)
                v += n * (keep + .4 - dl) * DT * 30.;
            if (dl < keep) {
                e += n * (keep - dl);
                v -= n * min(dot(v, n), 0.) * (kind == 2 ? 1. : 1.5);
            }
        }
        e += v * DT * info.x;
        // a bite
        vec3 body = pos + vec3(0, .5, 0) - e;
        if (length(body) < size + .7 && dead == 0. && info.x >= 1. && info.w <= 0.) {
            hurtPlayer(_TV(biteDamage, .12) * (kind == 2 ? .5 : kind == 3 ? 1.5 : 1.));
            vel += normalize(body) * 8. + vec3(0, 3, 0);
            v = -normalize(body) * 8.;
            enemyVel[i].w = 0.;
            info.zw = vec2(2, 1.5);
        }
        enemy[i].xyz = e;
        enemyVel[i].xyz = v;
        enemyInfo[i] = info;
        // far away: gone (others appear ahead)
        if (dist > (kind == 4 ? 120. : 70.) || dead > 0.)
            enemy[i].w = 0.;
    }

    // the enemies' shots
    for (int k = 0; k < MAX_SHOTS; k++) {
        if (shot[k].w <= 0.)
            continue;
        shot[k].w -= DT;
        shot[k].xyz += shotVel[k].xyz * DT;
        if (level(shot[k].xyz) < .1)
            shot[k].w = 0.;
        if (length(pos + vec3(0, .5, 0) - shot[k].xyz) < .9 && dead == 0.) {
            hurtPlayer(_TV(shotDamage, .08));
            vel += shotVel[k].xyz * .3;
            shot[k].w = 0.;
        }
    }

    // released light flies to the player
    for (int k = 0; k < MAX_ORBS; k++) {
        if (orb[k].w <= 0.)
            continue;
        vec3 to = pos + vec3(0, .6, 0) - orb[k].xyz;
        float d = length(to);
        orbVel[k].xyz = orbVel[k].xyz * .985 + to / d * 40. * DT;
        orb[k].xyz += orbVel[k].xyz * DT;
        if (d < .8 && dead == 0.) {
            orb[k].w = 0.;
            light = min(light + _TV(orbLight, .015), 1.);
        }
    }
}

void addLight(vec3 p, vec3 c)
{
    if (lightCount < MAX_LIGHTS && c.r > 0.) {
        lightPos[lightCount].xyz = p;
        lightCol[lightCount++].rgb = c;
    }
}

// The point lights: the player's lantern and muzzle flash, explosions, the
// enemies' shots and eyes (white when bursting), rockets, ammo crates, bolts,
// sparks, released light. In this order, in case there are too many.
void makeLights()
{
    vec3 eye = pos + vec3(0, EYE, 0);
    vec3 f = vec3(cos(yaw) * cos(pitch), sin(pitch), sin(yaw) * cos(pitch));
    vec3 r = normalize(cross(f, vec3(0, 1, 0))), u = cross(r, f);
    lightCount = 0;
    addLight(eye + u * .4 - f * .3, GOLD * (light * _TV(lantern, 1.2) + .05));
    addLight(eye + r * .2 - u * .2 + f * .55, GOLD * kick * kick * 6.);
    for (int i = 0; i < MAX_ROCKETS; i++)
        addLight(blast[i].xyz, ORANGE * 15. * max(.6 - blast[i].w, 0.) * step(1e-4, blast[i].w));
    for (int i = 0; i < MAX_SHOTS; i++)
        addLight(shot[i].xyz, RED * 3. * step(1e-4, shot[i].w));
    for (int i = 0; i < MAX_ENEMIES; i++)
        addLight(enemy[i].xyz + normalize(eye - enemy[i].xyz) * .9 * enemyScale(enemyKind[i]),
                 enemy[i].w < 0. ? vec3(4) * -enemy[i].w : RED * 1.5 * enemyInfo[i].x * step(1e-4, enemy[i].w));
    for (int i = 0; i < MAX_ROCKETS; i++)
        addLight(rocket[i].xyz, ORANGE * 4. * step(1e-4, rocket[i].w));
    for (int i = 0; i < NP; i++)
        addLight(PICKUPS[i], ORANGE * float((taken >> i & 1) == 0 && length(PICKUPS[i] - pos) < 20.));
    for (int i = 0; i < MAX_BOLTS; i++)
        addLight(bolt[i].xyz, GOLD * 2. * step(1e-4, bolt[i].w));
    for (int i = 0; i < MAX_SPARKS; i++)
        addLight(spark[i].xyz, GOLD * spark[i].w * 2.);
    for (int i = 0; i < MAX_ORBS; i++)
        addLight(orb[i].xyz, GOLD * 1.5 * orb[i].w);
}

void main()
{
    for (int i = 0; i < int(iInput[0].w); i++) {
        update();
        prevButtons = mod(iInput[0].z, 2.);
    }
    makeLights();
}
