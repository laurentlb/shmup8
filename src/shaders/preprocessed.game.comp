#version 430


layout(local_size_x = 1) in;


layout(location = 0) uniform vec4 iInput;

// Include begin: tweaks.frag
// --------------------------------------------------------------------





#define _TV(name, value)  (value)
#define _TVC(name, value) (value)
// --------------------------------------------------------------------
// Include end: tweaks.frag

// Include begin: state.glsl
// --------------------------------------------------------------------







#define TRAIL 32
#define MAX_BALLS 4

layout(std430, binding = 0) buffer State {
    
    
    int bumperEvents, flipperEvents, drainEvents, slingEvents;

    vec2 ball[MAX_BALLS], vel[MAX_BALLS]; 
    vec2 flip, flipVel; 
    float camTime;      
    vec2 slingFlash;    
    vec4 flash;         
    vec4 prevInput;
    float time;         
    float plunger;      
    float shake;        
    float gameOver;     
    float ballSave;     
    float slowMo;       
    float drainFlash;   
    int score, balls;   
    int mult;           
    int lanesLit;       
    int steps;
    int ballCount;      
    int pending;        
    float launchDelay;
    int targetsLit;     
    float alignTime;    
    int jackpot;        
    int jackpotLit;     
    int ballAdded;      
    int sets;           
    int multiballs;     
    float jackpotFlash;
    int award; float awardTime; 
    vec4 trail[TRAIL];  
};
// --------------------------------------------------------------------
// Include end: state.glsl

// Include begin: world.glsl
// --------------------------------------------------------------------




#define PI 3.14159
#define BALL_R 0.0135
#define CX -0.019     
#define LANE_X 0.244  
#define SUN vec2(CX, 0.13)
#define FLIP_REST -0.55 
#define FLIP_UP 0.45
#define FLIP_LEN 0.075


#define M_FLOOR 0.
#define M_WALL 1.
#define M_RAIL 2.
#define M_SLING 3.
#define M_FLIP 4.   
#define M_SUN 6.
#define M_PLANET 7. 
#define M_BALL 10.
#define M_ARM 11.
#define M_APRON 12.
#define M_POST 13.
#define M_TARGET 14.

mat2 rot(float a)
{
    float c = cos(a), s = sin(a);
    return mat2(c, s, -s, c);
}

float boxDist(vec2 p, vec2 size)
{
    vec2 d = abs(p) - size;
    return min(max(d.x, d.y), 0.) + length(max(d, 0.));
}

float segDist(vec2 p, vec2 a, vec2 b)
{
    vec2 pa = p - a, ba = b - a;
    return length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0., 1.));
}


float triDist(vec2 p, vec2 p0, vec2 p1, vec2 p2)
{
    vec2 e0 = p1 - p0, e1 = p2 - p1, e2 = p0 - p2;
    vec2 v0 = p - p0, v1 = p - p1, v2 = p - p2;
    vec2 pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0., 1.);
    vec2 pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0., 1.);
    vec2 pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0., 1.);
    float s = sign(e0.x * e2.y - e0.y * e2.x);
    vec2 d = min(min(vec2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
                     vec2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))),
                     vec2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));
    return -sqrt(d.x) * sign(d.y);
}


vec2 mirror(vec2 p)
{
    return vec2(CX - abs(p.x - CX), p.y);
}


float areaDist(vec2 p)
{
    return min(boxDist(p - vec2(0, -0.155), vec2(0.26, 0.445)), length(p - vec2(0, 0.29)) - 0.26);
}


float laneDist(vec2 p)
{
    return segDist(p, vec2(0.224, -0.6), vec2(0.224, 0.2)) - 0.004;
}


float railDist(vec2 q)
{
    return min(segDist(q, vec2(CX - 0.2, -0.2), vec2(CX - 0.2, -0.33)),
               segDist(q, vec2(CX - 0.2, -0.33), vec2(CX - 0.095, -0.415))) - 0.006;
}


float slingDist(vec2 q)
{
    return triDist(q, vec2(CX - 0.155, -0.2), vec2(CX - 0.155, -0.305), vec2(CX - 0.1, -0.345)) - 0.005;
}



float postDist(vec2 q)
{
    float d = triDist(q, vec2(CX - 0.243, 0.08), vec2(CX - 0.193, -0.03), vec2(CX - 0.243, -0.06));
    d = min(d, min(segDist(q, vec2(CX - 0.09, 0.4), vec2(CX - 0.09, 0.44)),
                   segDist(q, vec2(CX - 0.03, 0.4), vec2(CX - 0.03, 0.44))));
    return d - 0.005;
}


float gateDist(vec2 p)
{
    return segDist(p, vec2(0.222, 0.2), vec2(0.262, 0.235)) - 0.002;
}

vec2 flipPivot(int i)
{
    return vec2(CX + (i > 0 ? 0.085 : -0.085), -0.43);
}


float flipperDist(vec2 p, int i)
{
    if (i > 0) p.x = 2. * CX - p.x;
    p -= flipPivot(0);
    vec2 dir = vec2(cos(flip[i]), sin(flip[i]));
    float h = clamp(dot(p, dir) / FLIP_LEN, 0., 1.);
    return length(p - dir * h * FLIP_LEN) - mix(0.011, 0.005, h);
}


float planetRadius(int i)
{
    return i == 0 ? 0.015 : i == 1 ? 0.02 : 0.008;
}


float alignment()
{
    return alignTime > 0. ? smoothstep(0., 0.8, alignTime) * smoothstep(4., 3., alignTime) : 0.;
}


vec2 orbit(float a)
{
    a += alignment() * (mod(-PI / 2. - a + PI, 2. * PI) - PI);
    return vec2(cos(a), sin(a));
}

vec2 planetPos(int i, float t)
{
    if (i == 0) return SUN + 0.075 * orbit(t * 0.9);
    vec2 p = SUN + 0.14 * orbit(t * 0.35 + 2.);
    if (i > 1) p += 0.036 * orbit(t * 2.2);
    return p;
}



float targetDist(vec2 q)
{
    return min(length(q - vec2(CX - 0.135, -0.12)), length(q - vec2(CX - 0.045, -0.15))) - 0.009;
}


int targetIndex(vec2 p)
{
    return int(clamp(floor((p.x - CX) / 0.09 + 2.), 0., 3.));
}

vec2 hit(vec2 h, float d, float m)
{
    return d < h.x ? vec2(d, m) : h;
}



vec2 field(vec2 p, bool down)
{
    vec2 q = mirror(p);
    vec2 h = vec2(-areaDist(p), M_WALL);
    h = hit(h, min(laneDist(p), boxDist(p - vec2(LANE_X, -0.55), vec2(0.02, 0.05))), M_WALL);
    h = hit(h, railDist(q), M_RAIL);
    h = hit(h, slingDist(q), M_SLING);
    h = hit(h, postDist(q), M_POST);
    h = hit(h, targetDist(q), M_TARGET);
    if (down)
        h = hit(h, gateDist(p), M_WALL);
    for (int i = 0; i < 2; i++)
        h = hit(h, flipperDist(p, i), M_FLIP + float(i));
    h = hit(h, length(p - SUN) - 0.03, M_SUN);
    for (int i = 0; i < 3; i++)
        h = hit(h, length(p - planetPos(i, time)) - planetRadius(i), M_PLANET + float(i));
    return h;
}
// --------------------------------------------------------------------
// Include end: world.glsl


const float STEP = 1. / 120.;
float DT; 
#define SUBSTEPS 8 

bool multiball()
{
    return ballCount + pending > 1;
}


vec2 surfaceVelocity(vec2 p, float m)
{
    if (m >= M_PLANET && m < M_BALL) {
        int i = int(m - M_PLANET);
        return (planetPos(i, time + 0.01) - planetPos(i, time - 0.01)) * 50.;
    }
    if (m >= M_FLIP && m < M_SUN) {
        int i = int(m - M_FLIP);
        vec2 r = p - flipPivot(i);
        return flipVel[i] * (i > 0 ? -1. : 1.) * vec2(-r.y, r.x);
    }
    return vec2(0);
}


void bigAward(int points)
{
    award = points * mult;
    score += award;
    awardTime = 2.;
}

void bumper(int b, int i, vec2 n, int points)
{
    if (flash[i] < 0.8) {
        vel[b] += n * _TV(bumperKick, 0.55);
        flash[i] = 1.;
        score += points * mult;
        bumperEvents++;
        shake = max(shake, 0.4);
        if (i == 0) {
            slowMo = 0.08;
            
            if (multiball() && jackpotLit > 0) {
                jackpotLit = 0;
                bigAward(jackpot);
                jackpotFlash = 1.;
                slowMo = 0.6;
                shake = 1.;
                slingEvents++;
            }
        }
    }
}


void addBalls(int n)
{
    pending = min(pending + n, 3 - ballCount);
}



void target(vec2 p)
{
    int k = targetIndex(p);
    if ((targetsLit & 1 << k) != 0) {
        score += 50 * mult;
        return;
    }
    targetsLit |= 1 << k;
    score += 250 * mult;
    slingEvents++;
    if (targetsLit == 15) {
        targetsLit = 0;
        shake = 1.;
        flash = vec4(1);
        bumperEvents++;
        if (multiball()) {
            
            
            jackpotLit = 1;
            jackpot += 2500;
            bigAward(2500);
            if (ballAdded == 0)
                addBalls(1);
            ballAdded = 1;
            slowMo = 0.6;
            return;
        }
        
        if (++sets <= multiballs) {
            bigAward(2000);
            slowMo = 0.4;
            return;
        }
        sets = 0;
        multiballs++;
        bigAward(5000);
        addBalls(2);
        ballSave = max(ballSave, 12.);
        alignTime = 1e-3;
        if (jackpot == 0)
            jackpot = 5000;
        jackpotLit = 1;
        launchDelay = 1.5;
        slowMo = 1.5;
    }
}

void collide(int b)
{
    vec2 p = ball[b];
    vec2 h = field(p, vel[b].y < 0.);
    if (h.x >= BALL_R)
        return;
    float m = h.y;
    vec2 e = vec2(1e-4, 0);
    vec2 n = normalize(vec2(field(p + e, vel[b].y < 0.).x - field(p - e, vel[b].y < 0.).x,
                            field(p + e.yx, vel[b].y < 0.).x - field(p - e.yx, vel[b].y < 0.).x));
    vec2 vs = surfaceVelocity(p - n * h.x, m);
    ball[b] += n * (BALL_R - h.x);

    vec2 v = vel[b] - vs;
    float vn = dot(v, n);
    if (vn >= 0.)
        return;
    float bounce = m == M_RAIL || m == M_SLING || m == M_POST ? _TV(rubberBounce, 0.7)
                 : m == M_FLIP || m == M_FLIP + 1. ? _TV(flipperBounce, 0.45)
                 : _TV(wallBounce, 0.5);
    vel[b] = vs + v - (1. + bounce) * vn * n;

    if (m == M_SUN) bumper(b, 0, n, 100);
    if (m >= M_PLANET && m < M_BALL) bumper(b, int(m - M_PLANET) + 1, n, m > M_PLANET + 1.5 ? 500 : 50);
    if (m == M_TARGET && vn < -0.2) target(p);
    if (m == M_SLING) {
        int side = p.x > CX ? 1 : 0;
        if ((side > 0 ? -n.x : n.x) > 0.5 && slingFlash[side] < 0.5) {
            vel[b] += n * _TV(slingKick, 0.75);
            slingFlash[side] = 1.;
            score += 10 * mult;
            slingEvents++;
            shake = max(shake, 0.3);
        }
    }
}


void collideBalls()
{
    for (int i = 0; i < ballCount; i++)
        for (int j = i + 1; j < ballCount; j++) {
            vec2 d = ball[j] - ball[i];
            float l = length(d);
            if (l > 2. * BALL_R || l < 1e-6) continue;
            vec2 n = d / l;
            ball[i] -= n * (BALL_R - l * 0.5);
            ball[j] += n * (BALL_R - l * 0.5);
            float vn = dot(vel[j] - vel[i], n);
            if (vn < 0.) {
                vel[i] += n * vn * 0.95;
                vel[j] -= n * vn * 0.95;
            }
        }
}

bool inLane(vec2 p)
{
    return p.x > 0.226 && p.y < -0.3;
}


void serve()
{
    ball[0] = vec2(LANE_X, -0.5 + BALL_R);
    vel[0] = vec2(0);
    ballCount = 1;
    ballSave = _TV(ballSaveTime, 8.);
}


void lanes(vec2 p)
{
    int k = int(floor((p.x - CX + 0.09) / 0.06));
    if (p.y > 0.4 && p.y < 0.44 && k >= 0 && k < 3) {
        if ((lanesLit & 1 << k) == 0) {
            lanesLit |= 1 << k;
            score += 100 * mult;
            slingEvents++;
        }
    }
    if (lanesLit == 7) {
        lanesLit = 0;
        mult = min(mult + 1, 5);
        bigAward(1000);
        flash = vec4(1);
        bumperEvents++;
        shake = 1.;
        slowMo = 0.4;
    }
}

void update()
{
    drainFlash = max(drainFlash - STEP * 2., 0.);
    jackpotFlash = max(jackpotFlash - STEP * 2., 0.);
    awardTime = max(awardTime - STEP, 0.);
    
    camTime += STEP * (dot(abs(iInput.xyz), vec3(1)) > 0. ? 4. : 1.);
    
    slowMo = max(slowMo - STEP, 0.);
    DT = STEP * (1. - 0.8 * min(slowMo * 4., 1.));
    time += DT;
    if (alignTime > 0.)
        alignTime = alignTime > 4. ? 0. : alignTime + DT;
    
    
    if ((++steps & 1) == 0 || ballCount > 1) {
        for (int i = TRAIL - 1; i > 0; i--)
            trail[i] = trail[i - 1];
        int b = steps % max(ballCount, 1);
        trail[0] = vec4(ball[b], length(vel[b]), b);
    }
    flash = max(flash - DT * 4., 0.);
    slingFlash = max(slingFlash - DT * 4., 0.);
    shake = max(shake - DT * 3., 0.);

    if (balls <= 0) {
        ballCount = 0;
        pending = 0;
        gameOver -= DT;
        if (gameOver <= 0.) {
            score = 0;
            balls = 3;
            mult = 1;
            lanesLit = 0;
            targetsLit = 0;
            jackpot = 0;
            sets = 0;
            multiballs = 0;
            camTime = 0.;
            serve();
        }
    }

    
    launchDelay -= DT;
    bool laneFree = true;
    for (int b = 0; b < ballCount; b++)
        laneFree = laneFree && !inLane(ball[b]);
    if (pending > 0 && launchDelay <= 0. && laneFree) {
        ball[ballCount] = vec2(LANE_X, -0.45);
        vel[ballCount++] = vec2(0, _TV(autoLaunchSpeed, 2.8));
        pending--;
        launchDelay = 0.8;
        flipperEvents++;
    }

    vec2 up = iInput.xy;
    for (int i = 0; i < 2; i++)
        if (up[i] > prevInput[i]) {
            flipperEvents++;
            
            lanesLit = (i > 0 ? lanesLit << 1 | lanesLit >> 2 : lanesLit >> 1 | lanesLit << 2) & 7;
        }

    const float h = DT / float(SUBSTEPS);
    for (int s = 0; s < SUBSTEPS; s++) {
        for (int i = 0; i < 2; i++) {
            float speed = up[i] > 0. ? _TV(flipUpSpeed, 25.) : _TV(flipDownSpeed, 12.);
            float a = clamp((up[i] > 0. ? FLIP_UP : FLIP_REST) - flip[i], -speed * h, speed * h);
            flipVel[i] = a / h;
            flip[i] += a;
        }
        for (int b = 0; b < ballCount; b++) {
            vel[b].y -= _TV(gravity, 1.1) * h;
            ball[b] += vel[b] * h;
            collide(b);
        }
        collideBalls();
    }

    bool inPlayfield = false;
    for (int b = 0; b < ballCount; b++) {
        lanes(ball[b]);
        inPlayfield = inPlayfield || ball[b].x < 0.22;
        vel[b] *= 1. - _TV(rollingDamping, 0.1) * DT;
        float speed = length(vel[b]);
        if (speed > 3.2)
            vel[b] *= 3.2 / speed;
    }
    if (inPlayfield)
        ballSave = max(ballSave - DT, 0.); 

    
    if (iInput.z > 0. && camTime > 5.) 
        plunger = min(plunger + DT * 1.2, 1.);
    else if (plunger > 0.) {
        for (int b = 0; b < ballCount; b++)
            if (ball[b].x > 0.226 && ball[b].y < -0.45)
                vel[b].y = plunger * _TV(plungerSpeed, 2.6) + 0.4;
        plunger = 0.;
    }
    
    if (iInput.z < 0. && prevInput.z >= 0. && shake < 0.5) {
        for (int b = 0; b < ballCount; b++)
            vel[b] += vec2(0, 0.25);
        shake = 1.;
    }
    prevInput.xyz = iInput.xyz;

    
    for (int b = ballCount - 1; b >= 0; b--)
        if (ball[b].y < -0.53) {
            drainEvents++;
            shake = 1.;
            ball[b] = ball[--ballCount];
            vel[b] = vel[ballCount];
            if (ballSave > 0. && multiball())
                addBalls(1); 
        }
    if (!multiball())
        ballAdded = 0;
    if (balls > 0 && ballCount + pending == 0) {
        drainFlash = 1.;
        if (ballSave > 0.) {
            serve();
            ballSave = 0.;
            flash = vec4(1);
        } else {
            mult = 1;
            jackpot = 0;
            if (--balls > 0)
                serve();
            else
                gameOver = 3.;
        }
    }

}

void main()
{
    for (int i = 0; i < int(iInput.w); i++)
        update();
}
