#version 430


layout(local_size_x = 1) in;



layout(location = 0) uniform vec4 iInput[2];

// Include begin: tweaks.frag
// --------------------------------------------------------------------





#define _TV(name, value)  (value)
#define _TVC(name, value) (value)
// --------------------------------------------------------------------
// Include end: tweaks.frag

// Include begin: state.glsl
// --------------------------------------------------------------------







#define MAX_BOLTS 12
#define MAX_ENEMIES 10
#define MAX_SPARKS 8
#define MAX_ORBS 12
#define MAX_LIGHTS 24

layout(std430, binding = 0) buffer State {
    
    
    int shotEvents, hitEvents, killEvents, hurtEvents, jumpEvents, lapEvents;

    vec3 pos; float yaw;     
    vec3 vel; float pitch;
    float yawBase;           
    float light;             
    float lapTime, bestLap;
    int lap;
    int checkpoint;          
    float time;
    float cooldown;          
    float kick;              
    float shake, hurt, hitMark, lapFlash;
    float dead;              
    float bob;               
    int grounded, started, kills;
    uint rng;
    float spawnTimer;
    vec4 bolt[MAX_BOLTS];        
    vec4 boltVel[MAX_BOLTS];
    vec4 enemy[MAX_ENEMIES];     
    vec4 enemyVel[MAX_ENEMIES];  
    vec4 enemyInfo[MAX_ENEMIES]; 
    vec4 spark[MAX_SPARKS];      
    vec4 orb[MAX_ORBS];          
    vec4 orbVel[MAX_ORBS];
    
    int lightCount;
    vec4 lightPos[MAX_LIGHTS], lightCol[MAX_LIGHTS];
};
// --------------------------------------------------------------------
// Include end: state.glsl

// Include begin: world.glsl
// --------------------------------------------------------------------








#define PI 3.14159
#define NPTS 10
#define CW 3.5      
#define CH 5.5      
#define R_BODY 0.5  
#define EYE 1.      


#define GOLD vec3(1, .75, .4)
#define RED vec3(1, .05, .12)

const vec3 PTS[NPTS] = vec3[](
    vec3(0, 0, 0), vec3(36, 0, 0), vec3(54, 12, 0), vec3(54, 30, 0), vec3(54, 46, 4),
    vec3(30, 56, 4), vec3(2, 56, 4), vec3(-14, 46, 4), vec3(-20, 30, 0), vec3(-20, 14, 0));

const vec4 ARENAS[2] = vec4[](vec4(54, 12, 15, 12), vec4(-20, 14, 11, 9));




int tSeg;
float tU, tLat, tFloor, tArena;




uint seen = ~0u;


vec2 pillar(vec3 p)
{
    vec2 c = p.xz - ARENAS[0].xy;
    float a = mod(atan(c.y, c.x) + PI / 6., PI / 3.) - PI / 6.;
    return length(c) * vec2(cos(a), sin(a)) - vec2(8, 0);
}


float level(vec3 p)
{
    
    
    float lat = 1e9;
    for (int i = 0; i < NPTS; i++) {
        if ((seen >> i & 1u) == 0u)
            continue;
        vec3 a = PTS[i], b = PTS[(i + 1) % NPTS];
        vec2 ab = b.xy - a.xy, ap = p.xz - a.xy;
        float l = length(ab);
        float h = clamp(dot(ap, ab) / (l * l), 0., 1.);
        vec2 q = ap - ab * h;
        if (length(q) < lat) {
            lat = length(q);
            tSeg = i;
            tU = h * l;
            tLat = (ab.x * q.y - ab.y * q.x) / l;
            tFloor = mix(a.z, b.z, h);
        }
    }
    float inside = max(lat - CW, max(tFloor - p.y, p.y - tFloor - CH) * .95);
    tArena = 1e9;
    for (int i = 0; i < 2; i++) {
        vec4 A = ARENAS[i];
        tArena = min(tArena, max(length(p.xz - A.xy) - A.z, max(-p.y, p.y - A.w)));
    }
    float d = -min(inside, tArena);
    
    float u = mod(tU, 5.) - 2.5;
    d = min(d, max(max(abs(u) - .3, -tArena), min(CW - .3 - abs(tLat), tFloor + CH - .6 - p.y)));
    
    
    vec2 c = p.xz - ARENAS[0].xy;
    float r = abs(length(c) - 8.) - 1.;
    d = min(d, r > 1. ? r : length(pillar(p)) - 1.);
    c = p.xz - ARENAS[1].xy;
    r = abs(length(c) - 6.) - 1.2;
    float a = mod(atan(c.y, c.x) - .39 + PI / 4., PI / 2.) - PI / 4.;
    d = min(d, r > 1. ? r : length(length(c) * vec2(cos(a), sin(a)) - vec2(6, 0)) - 1.2);
    return d;
}

vec3 levelNormal(vec3 p)
{
    vec2 e = vec2(1, -1) * .01;
    return normalize(e.xyy * level(p + e.xyy) + e.yyx * level(p + e.yyx) +
                     e.yxy * level(p + e.yxy) + e.xxx * level(p + e.xxx));
}

float trackLength()
{
    float s = 0.;
    for (int i = 0; i < NPTS; i++)
        s += length(PTS[(i + 1) % NPTS].xy - PTS[i].xy);
    return s;
}


float trackPos()
{
    float s = tU;
    for (int i = 0; i < tSeg; i++)
        s += length(PTS[i + 1].xy - PTS[i].xy);
    return s;
}


vec3 trackPoint(float s)
{
    s = mod(s, trackLength());
    for (int i = 0; i < NPTS; i++) {
        vec3 a = PTS[i], b = PTS[(i + 1) % NPTS];
        float l = length(b.xy - a.xy);
        if (s < l) {
            a = mix(a, b, s / l);
            return a.xzy;
        }
        s -= l;
    }
    return vec3(0);
}
// --------------------------------------------------------------------
// Include end: world.glsl


const float DT = 1. / 120.;

float rnd()
{
    rng = rng * 1664525u + 1013904223u;
    return float(rng >> 8) / 16777216.;
}

vec3 rndDir()
{
    return normalize(vec3(rnd(), rnd(), rnd()) - .5);
}


void accelerate(vec3 wish, float cap, float accel)
{
    float add = cap - dot(vel, wish);
    if (add > 0.)
        vel += wish * min(add, accel * DT);
}

void addSpark(vec3 p, float power)
{
    int k = 0;
    for (int i = 1; i < MAX_SPARKS; i++)
        if (spark[i].w < spark[k].w) k = i;
    spark[k] = vec4(p, power);
}

void newRun()
{
    started = 1;
    pos = vec3(2, R_BODY + .01, 0);
    vel = vec3(0);
    yawBase = -iInput[1].x;
    light = 1.;
    lap = 1;
    checkpoint = 0;
    lapTime = 0.;
    dead = 0.;
    spawnTimer = 2.;
    for (int i = 0; i < MAX_ENEMIES; i++)
        enemy[i].w = 0.;
    for (int i = 0; i < MAX_ORBS; i++)
        orb[i].w = 0.;
}

void hitEnemy(int i, vec3 dir)
{
    enemy[i].w--;
    enemyInfo[i].y = 1.;
    enemyVel[i].xyz += dir * 3.;
    hitEvents++;
    hitMark = 1.;
    if (enemy[i].w <= 0.) {
        
        enemy[i].w = 0.;
        killEvents++;
        kills++;
        shake = max(shake, .4);
        addSpark(enemy[i].xyz, 4.);
        for (int k = 0, n = 0; k < MAX_ORBS && n < 3; k++)
            if (orb[k].w <= 0.) {
                orb[k] = vec4(enemy[i].xyz, 1);
                orbVel[k].xyz = rndDir() * 6. + vec3(0, 3, 0);
                n++;
            }
    }
}

void update()
{
    time += DT;
    if (started == 0)
        newRun();
    shake = max(shake - DT * 3., 0.);
    hurt = max(hurt - DT * 2., 0.);
    kick = max(kick - DT * 6., 0.);
    hitMark = max(hitMark - DT * 5., 0.);
    lapFlash = max(lapFlash - DT, 0.);
    for (int i = 0; i < MAX_SPARKS; i++)
        spark[i].w = max(spark[i].w - DT * 5., 0.);

    float fire = mod(iInput[0].z, 2.), jump = step(2., iInput[0].z);
    yaw = iInput[1].x + yawBase;
    pitch = iInput[1].y;
    vec3 fw = vec3(cos(yaw), 0, sin(yaw)), rt = vec3(-fw.z, 0, fw.x);
    vec3 look = vec3(fw.x * cos(pitch), sin(pitch), fw.z * cos(pitch));
    vec3 eye = pos + vec3(0, EYE, 0);

    if (dead > 0.) {
        dead += DT;
        vel = vec3(0);
        if (dead > 3.)
            newRun();
    } else {
        lapTime += DT;
        light -= DT * (_TV(drain, .012) + .004 * float(lap));
        if (light <= 0.) {
            light = 0.;
            dead = DT;
            hurtEvents++;
        }

        
        vec3 wish = fw * iInput[0].y + rt * iInput[0].x;
        float wl = length(wish);
        if (wl > 0.)
            wish /= wl;
        float speed = _TV(runSpeed, 10.);
        if (grounded > 0) {
            float s = length(vel.xz);
            if (s > 0.)
                vel.xz *= max(s - max(s, 3.) * _TV(friction, 6.) * DT, 0.) / s;
            accelerate(wish, speed * sign(wl), speed * _TV(accel, 10.));
            bob += s * DT;
            if (jump > 0.) {
                vel.y = _TV(jumpSpeed, 7.);
                jumpEvents++;
            }
        } else
            accelerate(wish, sign(wl), speed * _TV(airAccel, 1.));
        vel.y -= _TV(gravity, 20.) * DT;
        pos += vel * DT;
        grounded = 0;
        for (int k = 0; k < 3; k++) {
            float d = level(pos);
            if (d >= R_BODY)
                break;
            vec3 n = levelNormal(pos);
            pos += n * (R_BODY - d);
            vel -= n * min(dot(vel, n), 0.);
            if (n.y > .7)
                grounded = 1;
        }

        
        cooldown -= DT;
        if (fire > 0. && cooldown <= 0.) {
            cooldown = _TV(fireDelay, .11);
            kick = 1.;
            shotEvents++;
            float t = 0.;
            for (int k = 0; k < 40 && t < 80.; k++) {
                float d = level(eye + look * t);
                if (d < .05)
                    break;
                t += d;
            }
            vec3 muzzle = eye + look * .5 + rt * .2 - cross(rt, look) * .15;
            for (int k = 0; k < MAX_BOLTS; k++)
                if (bolt[k].w <= 0.) {
                    bolt[k] = vec4(muzzle, 1.2);
                    boltVel[k].xyz = normalize(eye + look * max(t, 2.) - muzzle) * _TV(boltSpeed, 70.);
                    break;
                }
        }

        
        level(pos);
        int q = int(trackPos() / trackLength() * 4.);
        if (q == (checkpoint + 1) % 4) {
            checkpoint = q;
            if (q == 0) {
                lap++;
                lapEvents++;
                bestLap = bestLap > 0. ? min(bestLap, lapTime) : lapTime;
                lapTime = 0.;
                light = min(light + .25, 1.);
                lapFlash = 1.;
            }
        }

        
        int alive = 0;
        for (int i = 0; i < MAX_ENEMIES; i++)
            alive += int(enemy[i].w > 0.);
        spawnTimer -= DT;
        if (alive < min(2 + 2 * lap, MAX_ENEMIES) && spawnTimer <= 0.) {
            spawnTimer = max(_TV(spawnDelay, 2.5) - .25 * float(lap), .7);
            vec3 s = trackPoint(trackPos() + 25. + rnd() * 15.) + vec3(rnd() * 4. - 2., 1.8 + rnd() * 1.5, rnd() * 4. - 2.);
            for (int i = 0; i < MAX_ENEMIES; i++)
                if (enemy[i].w <= 0.) {
                    enemy[i] = vec4(s, 2. + floor(float(lap) * .5));
                    enemyVel[i] = vec4(0);
                    enemyInfo[i] = vec4(0, 0, 1.5, 0);
                    break;
                }
        }
    }

    
    for (int k = 0; k < MAX_BOLTS; k++) {
        if (bolt[k].w <= 0.)
            continue;
        bolt[k].w -= DT;
        vec3 p = bolt[k].xyz, v = boltVel[k].xyz, dir = normalize(v);
        float len = length(v) * DT;
        for (int i = 0; i < MAX_ENEMIES; i++) {
            if (enemy[i].w <= 0.)
                continue;
            vec3 e = enemy[i].xyz - p;
            float h = clamp(dot(e, dir), 0., len);
            if (length(e - dir * h) < .7 * enemyInfo[i].x + .1) {
                hitEnemy(i, dir);
                addSpark(p + dir * h, 1.5);
                bolt[k].w = 0.;
                break;
            }
        }
        float t = 0.;
        for (int s = 0; s < 4 && t < len && bolt[k].w > 0.; s++) {
            float d = level(p + dir * t);
            if (d < .05) {
                addSpark(p + dir * (t - .1), 1.);
                bolt[k].w = 0.;
            }
            t += d;
        }
        bolt[k].xyz += v * DT;
    }

    
    for (int i = 0; i < MAX_ENEMIES; i++) {
        if (enemy[i].w <= 0.)
            continue;
        vec4 info = enemyInfo[i];
        info.x = min(info.x + DT, 1.);
        info.yzw = max(info.yzw - vec3(6, 1, 1) * DT, 0.);
        vec3 e = enemy[i].xyz, v = enemyVel[i].xyz;
        vec3 to = eye - vec3(0, .3, 0) - e;
        float dist = length(to);
        to /= dist;
        if (enemyVel[i].w > 0.)
            enemyVel[i].w -= DT;
        else {
            v += (to * (_TV(enemySpeed, 4.) + .5 * float(lap)) - v) * DT * 2.;
            v.y += sin(time * 2. + float(i)) * DT * 2.;
            if (dist < 9. && info.z <= 0. && dead == 0.) {
                v = to * (12. + float(lap));
                enemyVel[i].w = .6;
                info.z = 2.5;
            }
        }
        
        for (int j = 0; j < MAX_ENEMIES; j++) {
            vec3 d = e - enemy[j].xyz;
            float l = length(d);
            if (j != i && enemy[j].w > 0. && l < 2.5 && l > 0.)
                v += d / l * (2.5 - l) * DT * 8.;
        }
        
        float dl = level(e);
        if (dl < 1.) {
            vec3 n = levelNormal(e);
            v += n * (1. - dl) * DT * 30.;
            if (dl < .6) {
                e += n * (.6 - dl);
                v -= n * min(dot(v, n), 0.) * 1.5;
            }
        }
        e += v * DT * info.x;
        
        vec3 body = pos + vec3(0, .5, 0) - e;
        if (length(body) < 1.3 && dead == 0. && info.x >= 1. && info.w <= 0.) {
            light -= _TV(biteDamage, .12);
            hurt = 1.;
            shake = 1.;
            hurtEvents++;
            vel += normalize(body) * 8. + vec3(0, 3, 0);
            v = -normalize(body) * 8.;
            enemyVel[i].w = 0.;
            info.zw = vec2(2, 1.5);
        }
        enemy[i].xyz = e;
        enemyVel[i].xyz = v;
        enemyInfo[i] = info;
        
        if (dist > 70. || dead > 0.)
            enemy[i].w = 0.;
    }

    
    for (int k = 0; k < MAX_ORBS; k++) {
        if (orb[k].w <= 0.)
            continue;
        vec3 to = pos + vec3(0, .6, 0) - orb[k].xyz;
        float d = length(to);
        orbVel[k].xyz = orbVel[k].xyz * .985 + to / d * 40. * DT;
        orb[k].xyz += orbVel[k].xyz * DT;
        if (d < .8) {
            orb[k].w = 0.;
            light = min(light + _TV(orbLight, .04), 1.);
        }
    }
}

void addLight(vec3 p, vec3 c)
{
    if (lightCount < MAX_LIGHTS && c.r > 0.) {
        lightPos[lightCount].xyz = p;
        lightCol[lightCount++].rgb = c;
    }
}



void makeLights()
{
    vec3 eye = pos + vec3(0, EYE, 0);
    vec3 f = vec3(cos(yaw) * cos(pitch), sin(pitch), sin(yaw) * cos(pitch));
    vec3 r = normalize(cross(f, vec3(0, 1, 0))), u = cross(r, f);
    lightCount = 0;
    addLight(eye + u * .4 - f * .3, GOLD * (light * _TV(lantern, 2.) + .05));
    addLight(eye + r * .2 - u * .2 + f * .55, GOLD * kick * kick * 6.);
    for (int i = 0; i < MAX_BOLTS; i++)
        addLight(bolt[i].xyz, GOLD * 3. * step(1e-4, bolt[i].w));
    for (int i = 0; i < MAX_SPARKS; i++)
        addLight(spark[i].xyz, GOLD * spark[i].w * 2.);
    for (int i = 0; i < MAX_ORBS; i++)
        addLight(orb[i].xyz, GOLD * 1.5 * orb[i].w);
    for (int i = 0; i < MAX_ENEMIES; i++)
        addLight(enemy[i].xyz + normalize(eye - enemy[i].xyz) * .6, RED * .6 * enemyInfo[i].x * step(1e-4, enemy[i].w));
}

void main()
{
    for (int i = 0; i < int(iInput[0].w); i++)
        update();
    makeLights();
}
