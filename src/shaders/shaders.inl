       "if(m<.8&&G==0.)"
         "_[f].w=0.,b=min(b+.015,1.);"
     "}"
 "}"
 "void bd(vec3 v,vec3 a)"
 "{"
   "if(au<32&&a.x>0.)"
     "am[au].xyz=v,aj[au++].xyz=a;"
 "}"
 "void bp()"
 "{"
   "vec3 a=u+vec3(0,1,0),v=vec3(cos(w)*cos(n),sin(n),sin(w)*cos(n)),i=normalize(cross(v,vec3(0,1,0))),f=cross(i,v);"
   "au=0;"
   "bd(a+f*.4-v*.3,vec3(1,.75,.4)*(b*1.2+.05));"
   "bd(a+i*.2-f*.2+v*.55,vec3(1,.75,.4)*B*B*6.);"
   "for(int i=0;i<4;i++)"
     "bd(ab[i].xyz,vec3(1,.4,.1)*15.*max(.6-ab[i].w,0.)*step(1e-4,ab[i].w));"
   "for(int i=0;i<10;i++)"
     "bd(j[i].xyz,vec3(1,.05,.12)*3.*step(1e-4,j[i].w));"
   "for(int i=0;i<12;i++)"
     "bd(U[i].xyz+normalize(a-U[i].xyz)*.9*bf(V[i]),U[i].w<0.?"
       "vec3(4)*-U[i].w:"
       "vec3(1,.05,.12)*1.5*X[i].x*step(1e-4,U[i].w));"
   "for(int i=0;i<4;i++)"
     "bd(at[i].xyz,vec3(1,.4,.1)*4.*step(1e-4,at[i].w));"
   "for(int i=0;i<6;i++)"
     "bd(bh[i],vec3(1,.4,.1)*float((al>>i&1)==0&&length(bh[i]-u)<20.));"
   "for(int i=0;i<24;i++)"
     "bd(R[i].xyz,vec3(1,.75,.4)*2.*step(1e-4,R[i].w));"
   "for(int i=0;i<8;i++)"
     "bd(Z[i].xyz,vec3(1,.75,.4)*Z[i].w*2.);"
   "for(int i=0;i<12;i++)"
     "bd(_[i].xyz,vec3(1,.75,.4)*1.5*_[i].w);"
 "}"
 "void main()"
 "{"
   "for(int i=0;i<int(bj[0].w);i++)"
     "bd(),N=mod(bj[0].z,2.);"
   "bp();"
 "}";

