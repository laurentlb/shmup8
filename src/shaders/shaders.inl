         "O[f].w=0.,s=min(s+.04,1.);"
     "}"
 "}"
 "void aJ(vec3 v,vec3 a)"
 "{"
   "if(Q<24&&a.x>0.)"
     "R[Q].xyz=v,T[Q++].xyz=a;"
 "}"
 "void ah()"
 "{"
   "vec3 v=u+vec3(0,1,0),i=vec3(cos(c)*cos(a),sin(a),sin(c)*cos(a)),f=normalize(cross(i,vec3(0,1,0))),m=cross(f,i);"
   "Q=0;"
   "aJ(v+m*.4-i*.3,vec3(1,.75,.4)*(s*1.2+.05));"
   "aJ(v+f*.2-m*.2+i*.55,vec3(1,.75,.4)*g*g*6.);"
   "for(int f=0;f<12;f++)"
     "aJ(I[f].xyz,vec3(1,.75,.4)*3.*step(1e-4,I[f].w));"
